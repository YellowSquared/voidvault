{
  "manifest_version": 3,
  "name": "VoidVault",
  "version": "0.2.0",
  "description": "Zero-knowledge hardware-bound password vault with WebAuthn PRF.",
  "homepage_url": "https://github.com/YellowSquared/voidvault",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "http://localhost:8081/*",
    "*://*/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "voidvault@voidvault.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "background": {
    "scripts": [
      "crypto.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "VoidVault",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
