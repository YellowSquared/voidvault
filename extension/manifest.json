{
  "manifest_version": 3,
  "name": "VoidVault Minimal",
  "version": "0.2.0",
  "description": "Zero-knowledge hardware-bound password vault with WebAuthn PRF.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "http://localhost:8081/*",
    "*://*/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "voidvault-minimal@voidvault.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "background": {
    "scripts": [
      "crypto.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "VoidVault Minimal"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
